.vs/
.idea/
*.user

# Local-only: the art pipeline, an old copy of the assets (the mod uses KrisMod/Assets), tooling
# state and logs. The repository holds only what builds and packages the mod.
KrisRig/
/Assets/
.blender-toolkit/
*.log
